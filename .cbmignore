# codebase-memory-mcp ignore file
# Exclude folders that are not part of the source code or carry excessive token weight.

# Agent customizations and prompt files
/.agents/
/.codex/
/.gemini/
/backups/
/database/

# Documentation (PRD, SRS, SDD, etc. - read directly using view_file)
/docs/

# Local deployment configurations and environments
/.env
/*.env
/*.env.*
/docker-compose*.yml

# Logs and outputs
/*.log
/npm-debug.log*
/yarn-debug.log*
/pnpm-debug.log*
/storage/exports/

# Scripts and bats
/*.bat
/scripts/
