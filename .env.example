NODE_ENV=development
APP_NAME=POS_APOTEK
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=/api
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pos_apotek?schema=public
JWT_SECRET=change_me_dev_secret_please_replace
# JWT_ACCESS_SECRET is optional. If omitted, backend uses JWT_SECRET for access tokens.
JWT_ACCESS_SECRET=change_me_access_secret_please_replace
JWT_REFRESH_SECRET=change_me_refresh_secret_please_replace
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10,http://192.168.1.10:5173
CORS_ALLOW_LOCAL_NETWORK=true
LOCAL_NETWORK_MODE=true
LOCAL_SERVER_IP=192.168.1.10
VITE_API_BASE_URL=/api
APP_TIMEZONE=Asia/Makassar
VITE_APP_TIMEZONE=Asia/Makassar
VITE_LOCAL_NETWORK_MODE=true
VITE_ENABLE_CONNECTION_STATUS=true
EXPORT_DIR=storage/exports
