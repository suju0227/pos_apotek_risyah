NODE_ENV=development
APP_NAME=POS_APOTEK
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=/api
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# ZeroTier private access example, replace with the server's ZeroTier managed IP if used:
# APP_URL=http://ZERO_TIER_IP_SERVER
# FRONTEND_URL=http://ZERO_TIER_IP_SERVER
# Supabase provides POSTGRES_PRISMA_URL; DATABASE_URL remains supported for local Docker.
DATABASE_URL=${POSTGRES_PRISMA_URL}
JWT_SECRET=change_me_dev_secret_please_replace
# JWT_ACCESS_SECRET is optional. If omitted, backend uses JWT_SECRET for access tokens.
JWT_ACCESS_SECRET=change_me_access_secret_please_replace
JWT_REFRESH_SECRET=change_me_refresh_secret_please_replace
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10,http://192.168.1.10:5173
# ZeroTier direct backend/dev access example, append the ZeroTier origin without dropping local dev origins:
# CORS_ORIGIN=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10,http://192.168.1.10:5173,http://ZERO_TIER_IP_SERVER
CORS_ALLOW_LOCAL_NETWORK=true
LOCAL_NETWORK_MODE=true
LOCAL_SERVER_IP=192.168.1.10
# LOCAL_SERVER_IP=ZERO_TIER_IP_SERVER
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=300
APP_TIMEZONE=Asia/Makassar
EXPORT_DIR=storage/exports
