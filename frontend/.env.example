VITE_APP_NAME=POS_APOTEK
# Local production via Nginx reverse proxy:
VITE_API_BASE_URL=/api
# Development direct backend example:
# VITE_API_BASE_URL=http://localhost:3000/api
# Direct LAN backend example, replace IP with the real server IP:
# VITE_API_BASE_URL=http://IP_SERVER:3000/api
VITE_APP_TIMEZONE=Asia/Makassar
VITE_LOCAL_NETWORK_MODE=true
VITE_ENABLE_CONNECTION_STATUS=true
